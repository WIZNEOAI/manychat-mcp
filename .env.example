# Local stdio only. Never paste your key into a chat.
MANYCHAT_API_KEY=
# HTTP uses request credentials, never MANYCHAT_API_KEY as a fallback.
MCP_REMOTE_AUTH=manychat_header
PORT=3000
# OAuth production requires a shared Redis and a public HTTPS origin.
# OAUTH_STORE=redis
# REDIS_URL=
# MCP_BASE_URL=https://your-mcp.example
