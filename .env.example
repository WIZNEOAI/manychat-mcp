# Local stdio only. Never paste your key into a chat.
MANYCHAT_API_KEY=
# HTTP uses request credentials, never MANYCHAT_API_KEY as a fallback.
MCP_REMOTE_AUTH=manychat_header
PORT=3000
# OAuth production requires a shared Redis and a public HTTPS origin.
# OAUTH_STORE=redis
# REDIS_URL=
# MCP_BASE_URL=https://your-mcp.example

# Logging level (supported values depend on logger configuration).
# LOG_LEVEL=info
# Bind address for HTTP.
# HOST=0.0.0.0
# Current trusted-proxy configuration; set only trusted ingress CIDRs.
# TRUST_PROXY_CIDRS=
# Production requires TRUST_PROXY_CIDRS OR TRUST_PROXY_HOPS, never both.
# On Render use 1 only with exclusive proxy ingress (no direct/shorter route).
# TRUST_PROXY_HOPS=1
# Human-operated support only; disabled by default. Tools cannot enable this.
# MANYCHAT_ALLOW_HUMAN_AGENT=1
# Every Redis OAuth store requires 32 random bytes encoded as 64 hex characters.
# OAUTH_ENC_KEY=
